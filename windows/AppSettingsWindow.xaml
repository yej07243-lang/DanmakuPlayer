<Window x:Class="DanmakuPlayerWin.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="470" Width="480"
        Background="{DynamicResource Bg.Panel}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="外观" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="主题" Width="86" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeBox" Width="140" Height="28" SelectionChanged="OnThemeChanged" />
                <TextBlock x:Name="VersionText" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
                <Button Content="关于…" Width="72" Height="28" Margin="12,0,0,0" Click="OnAboutClick" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="弹幕显示（应用到所有播放窗口）" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,10" />
            <CheckBox x:Name="EnabledCheck" Content="显示弹幕" Click="OnEnabledChanged" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="字号" VerticalAlignment="Center" />
            <Slider Grid.Column="1" x:Name="FontSlider" Minimum="16" Maximum="40" TickFrequency="1"
                    VerticalAlignment="Center" ValueChanged="OnFontChanged" AutomationProperties.Name="弹幕字号" />
            <TextBlock Grid.Column="2" x:Name="FontValue" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="数据目录" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,6" />
            <TextBlock x:Name="DataDirText" Foreground="{DynamicResource TextSecondary}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="打开数据目录" Click="OnOpenDataClick" />
                <Button Content="导出诊断日志…" Margin="8,0,0,0" Click="OnExportLogsClick" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="4" Foreground="{DynamicResource TextMuted}"
                   Text="主题默认跟随 Windows 的浅色/深色设置；视频画面不受主题影响。弹幕的字体、透明度、速度等细项在播放器的「弹幕设置」里调。" />

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button Content="关闭" Width="88" Height="30" HorizontalAlignment="Right" Click="OnCloseClick" />
        </DockPanel>
    </Grid>
</Window>
