<Window x:Class="DanmakuPlayerWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpv="clr-namespace:DanmakuPlayerWin.Mpv"
        Title="DanmakuPlayer" Height="820" Width="1280"
        Background="{DynamicResource Bg.Window}" WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown" Closing="OnWindowClosing"
        AllowDrop="True" Drop="OnDropFile" DragOver="OnDragOverFile">
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BarGlyph" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Bg.Surface}" Padding="8">
            <DockPanel LastChildFill="True">
                <Button x:Name="OpenButton" Content="打开文件" Width="88" Style="{StaticResource BarButton}" Click="OnOpenClick"
                        AutomationProperties.Name="打开视频文件" />
                <Button x:Name="DanmakuButton" Content="弹幕 XML" Width="88" Style="{StaticResource BarButton}" Click="OnLoadDanmakuClick"
                        AutomationProperties.Name="载入弹幕 XML" />
                <Button x:Name="BiliButton" Content="B 站链接…" Width="92" Style="{StaticResource BarButton}" Click="OnBiliClick"
                        AutomationProperties.Name="B 站弹幕来源" />
                <Button x:Name="CacheMenuButton" Content="缓存…" Width="64" Style="{StaticResource BarButton}" Click="OnCacheMenuClick"
                        AutomationProperties.Name="弹幕缓存菜单">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="刷新 B 站弹幕" Click="OnRefreshBiliClick" />
                            <MenuItem Header="清除弹幕缓存" Click="OnClearDanmakuCacheClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="PlaylistButton" Content="剧集列表" Width="80" Style="{StaticResource BarButton}" Click="OnPlaylistMenuClick"
                        AutomationProperties.Name="剧集列表">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="PlaylistMenu" Opened="OnPlaylistMenuOpened" />
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="CalibrateButton" Content="校准…" Width="72" Style="{StaticResource BarButton}" Click="OnCalibrateClick"
                        AutomationProperties.Name="弹幕时间校准" />
                <TextBlock x:Name="CalibrationText" Foreground="{DynamicResource Accent}" Width="96" TextAlignment="Center" Text="未校准" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Text}" FontSize="13" Text="未加载文件"
                           TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
            </DockPanel>
        </Border>

        <mpv:VideoHost x:Name="Video" Grid.Row="1" />

        <Border x:Name="ErrorBanner" Grid.Row="2" Background="{DynamicResource ErrorBg}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="0,0,0,1"
                Padding="12,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Width="28" Height="24"
                        Background="Transparent" Foreground="{DynamicResource ErrorText}" BorderThickness="0" Click="OnCloseErrorClick"
                        ToolTip="关闭" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource Bg.SurfaceAlt}" Padding="10,4,10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TimeText" Grid.Column="0" Width="62" Text="0:00" TextAlignment="Left" />
                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="8,0,8,0"
                        VerticalAlignment="Center" ValueChanged="OnSeekValueChanged"
                        PreviewMouseLeftButtonDown="OnSeekDragStart" PreviewMouseLeftButtonUp="OnSeekDragEnd"
                        AutomationProperties.Name="播放进度" />
                <TextBlock x:Name="DurationText" Grid.Column="2" Width="62" Text="0:00" TextAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource Bg.Surface}" Padding="8">
            <DockPanel LastChildFill="False">
                <Button x:Name="BackButton" Content="−5s" Width="52" Style="{StaticResource BarButton}" Click="OnBackClick"
                        AutomationProperties.Name="后退 5 秒" />
                <Button x:Name="PlayButton" Content="&#xE768;" Style="{StaticResource BarGlyph}" Click="OnPlayClick"
                        AutomationProperties.Name="播放或暂停" />
                <Button x:Name="ForwardButton" Content="+5s" Width="52" Style="{StaticResource BarButton}" Click="OnForwardClick"
                        AutomationProperties.Name="前进 5 秒" />

                <TextBlock Text="速度" Margin="10,0,6,0" />
                <ComboBox x:Name="SpeedBox" Width="78" SelectionChanged="OnSpeedChanged" AutomationProperties.Name="播放速度" />

                <TextBlock Text="音轨" Margin="4,0,6,0" />
                <ComboBox x:Name="AudioBox" Width="130" SelectionChanged="OnAudioChanged" AutomationProperties.Name="音轨选择" />

                <TextBlock Text="字幕" Margin="4,0,6,0" />
                <ComboBox x:Name="SubtitleBox" Width="130" SelectionChanged="OnSubtitleChanged" AutomationProperties.Name="字幕选择" />
                <Button x:Name="SubtitleMenuButton" Content="字幕…" Width="64" Style="{StaticResource BarButton}"
                        Click="OnSubtitleMenuClick" ToolTip="加载外挂字幕 / 字幕延迟"
                        AutomationProperties.Name="字幕菜单">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="加载字幕文件…" Click="OnAddSubtitleClick" />
                            <MenuItem Header="字幕提前 0.1 秒" Click="OnSubtitleEarlierClick" />
                            <MenuItem Header="字幕延后 0.1 秒" Click="OnSubtitleLaterClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <CheckBox x:Name="DanmakuToggle" Content="弹幕" IsChecked="True" Click="OnToggleDanmakuClick"
                          AutomationProperties.Name="显示弹幕" />
                <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource BarGlyph}" Click="OnDanmakuSettingsClick"
                        ToolTip="弹幕设置" AutomationProperties.Name="弹幕设置" />

                <Button x:Name="MuteButton" Content="&#xE767;" Style="{StaticResource BarGlyph}" Click="OnMuteClick" Margin="6,0,4,0"
                        AutomationProperties.Name="静音" />
                <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="100" Value="80"
                        VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="OnVolumeChanged"
                        AutomationProperties.Name="音量" />

                <Button x:Name="FullScreenButton" Content="&#xE740;" Style="{StaticResource BarGlyph}" Click="OnFullScreenClick"
                        ToolTip="全屏 (F)" AutomationProperties.Name="全屏" />
                <TextBlock x:Name="HintText" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                           Text="空格 播放/暂停 · ←/→ ±5s · [ ] 偏移 · C 校准 · F 全屏 · D 弹幕" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

