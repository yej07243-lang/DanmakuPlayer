<Application x:Class="DanmakuPlayerWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/ThemeDark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
                <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
